{
  "expo": {
    "name": "Level Fit",
    "slug": "level-fit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "levelfit",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.levelfit.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ]
      },
      "infoPlist": {
        "NSCameraUsageDescription": "O Level Fit usa a câmera para você tirar a foto de prova dos seus hábitos.",
        "NSPhotoLibraryUsageDescription": "O Level Fit acessa suas fotos para você escolher a prova de um hábito."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2B1B17",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.levelfit.app",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_MINDFULNESS"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF3E3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O Level Fit usa a câmera para você tirar a foto de prova dos seus hábitos.",
          "photosPermission": "O Level Fit acessa suas fotos para você escolher a prova de um hábito.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F26B1D"
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "DuelWidget",
              "displayName": "Level Fit — Placar",
              "description": "Placar do duelo de hoje e suas metas",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryCircular",
                  "accessoryRectangular"
                ],
                "initialLayout": "./src/widgets/DuelWidget.ios.tsx"
              },
              "android": {
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "minWidth": 250,
                "minHeight": 110,
                "initialLayout": "./src/widgets/DuelWidget.android.tsx"
              }
            }
          ]
        }
      ],
      "expo-font",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "O Level Fit lê passos, treinos, sono, meditação e tempo ao ar livre do app Saúde (incluindo seu relógio) para registrar sozinho as metas que você bateu nos duelos.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "react-native-share",
        {
          "ios": ["instagram", "instagram-stories"],
          "android": ["com.instagram.android"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#FFF3E3"
  }
}
