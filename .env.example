# Obrigatório: as contas e os duelos ficam no Supabase (veja o README).
# Painel do Supabase > Project Settings > API Keys > Publishable key.
# Nunca coloque a secret/service_role key aqui: tudo que começa com EXPO_PUBLIC_ vai junto no app.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Premium (RevenueCat). Chaves públicas do SDK de cada loja (Project settings > API keys no RevenueCat).
# Sem elas o app funciona, mas a tela de assinatura fica "indisponível". Exige novo build nativo.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...

# Link da política de privacidade publicada (o mesmo do App Store Connect).
# Sem ele, os links abrem a versão que vem no app (src/lib/privacyPolicy.ts).
# Texto pronto para publicar: docs/privacy-policy.md
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://...

# E-mail de suporte mostrado em Minha conta e na política (a App Store exige um contato).
EXPO_PUBLIC_SUPPORT_EMAIL=suporte@seudominio.com
