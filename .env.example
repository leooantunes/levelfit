# Obrigatório: as contas e os duelos ficam no Supabase (veja o README).
# Painel do Supabase > Project Settings > API Keys > Publishable key.
# Nunca coloque a secret/service_role key aqui: tudo que começa com EXPO_PUBLIC_ vai junto no app.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Premium (RevenueCat, entitlement levelfit_pro). Chaves públicas do SDK (Project settings > API keys).
# Test Store (test_...): para testar compras sem loja; só é usada em desenvolvimento (__DEV__).
EXPO_PUBLIC_REVENUECAT_TEST_KEY=test_...
# Chaves das lojas (produção). Sem elas o app funciona, mas a assinatura fica "indisponível". Exige novo build nativo.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...

# Opcional. Por padrão o app já abre a política do site da SideQuest Studio:
# https://sidequeststud-io.netlify.app/apps/levelfit/privacidade
# EXPO_PUBLIC_PRIVACY_POLICY_URL=

# Opcional. Link dos termos de uso, quando existirem no site.
# Sem ele, o app usa o EULA padrão da Apple / termos do Google Play.
# EXPO_PUBLIC_TERMS_URL=

# Facebook App ID (developers.facebook.com → Criar app). A Meta exige para o botão
# "Postar no Story" abrir o editor de Stories do Instagram direto. Sem ele, abre o
# menu de compartilhar do celular (a pessoa escolhe Instagram → Story).
EXPO_PUBLIC_FACEBOOK_APP_ID=

# Opcional. E-mail de suporte; o padrão é contato@sidequest.studio.
# EXPO_PUBLIC_SUPPORT_EMAIL=
